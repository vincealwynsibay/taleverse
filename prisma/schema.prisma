generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  USER
}

enum NovelStatus {
  ONGOING
  COMPLETED
  HIATUS
}

enum LedgerKind {
  PURCHASE // bought a credit pack
  GRANT // free credits (signup bonus, demo)
  SPEND // unlocked a chapter
  REFUND
}

model User {
  id               Int      @id @default(autoincrement())
  clerkId          String   @unique
  email            String   @unique
  username         String
  imageUrl         String?
  role             UserRole @default(USER)
  isDemo           Boolean  @default(false)
  stripeCustomerId String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ledger   CreditLedgerEntry[]
  unlocks  ChapterUnlock[]
  library  LibraryEntry[]
  progress ReadingProgress[]
  reviews  Review[]
  comments Comment[]
  votes    CommentVote[]
}

model Genre {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  slug   String  @unique
  novels Novel[]
}

model Novel {
  id          Int         @id @default(autoincrement())
  title       String      @unique
  slug        String      @unique
  author      String
  synopsis    String
  releaseYear Int?
  coverUrl    String?
  // Wide artwork for the novel page and the home spotlight.
  bannerUrl   String?
  // Attribution for public-domain cover/banner art, e.g. "Cover: 1897 first edition · Public domain".
  artCredit   String?
  artCreditUrl String?
  // Hue (0-360) for the generated typographic cover when there's no coverUrl.
  coverHue    Int         @default(200)
  status      NovelStatus @default(ONGOING)
  isSeed      Boolean     @default(false)
  views       Int         @default(0)
  // Denormalized from Review, updated in the same transaction as each review write.
  ratingAvg   Float       @default(0)
  ratingCount Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  genres   Genre[]
  chapters Chapter[]
  library  LibraryEntry[]
  progress ReadingProgress[]
  reviews  Review[]
}

model Chapter {
  id          Int       @id @default(autoincrement())
  novelId     Int
  number      Int
  title       String
  // BlockNote document (array of blocks).
  content     Json      @default("[]")
  wordCount   Int       @default(0)
  // null = draft. Visible to readers once publishedAt <= now.
  publishedAt DateTime?
  // null = free as soon as it's published. Otherwise early access until freeAt.
  freeAt      DateTime?
  unlockPrice Int       @default(5)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  novel    Novel             @relation(fields: [novelId], references: [id], onDelete: Cascade)
  unlocks  ChapterUnlock[]
  comments Comment[]
  progress ReadingProgress[]

  @@unique([novelId, number])
  @@index([publishedAt])
}

// Append-only. A user's balance is SUM(delta).
model CreditLedgerEntry {
  id             Int        @id @default(autoincrement())
  userId         Int
  delta          Int
  kind           LedgerKind
  // Makes every write retry-safe: "stripe:<checkout session id>", "unlock:<user>:<chapter>", ...
  idempotencyKey String     @unique
  description    String
  createdAt      DateTime   @default(now())

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  unlock ChapterUnlock?

  @@index([userId, createdAt])
}

model ChapterUnlock {
  userId        Int
  chapterId     Int
  ledgerEntryId Int      @unique
  createdAt     DateTime @default(now())

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter     Chapter           @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  ledgerEntry CreditLedgerEntry @relation(fields: [ledgerEntryId], references: [id], onDelete: Cascade)

  @@id([userId, chapterId])
}

model CreditPack {
  id         Int     @id @default(autoincrement())
  name       String
  credits    Int
  priceCents Int
  highlight  Boolean @default(false)
  active     Boolean @default(true)
}

model LibraryEntry {
  userId    Int
  novelId   Int
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@id([userId, novelId])
}

model ReadingProgress {
  userId    Int
  novelId   Int
  chapterId Int
  // 0..1 scroll position within the chapter.
  position  Float    @default(0)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel   Novel   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@id([userId, novelId])
  @@index([userId, updatedAt])
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  novelId   Int
  rating    Int
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)

  @@unique([userId, novelId])
  @@index([novelId, createdAt])
}

model Comment {
  id        Int       @id @default(autoincrement())
  userId    Int
  chapterId Int
  /// Reply to another comment (threaded, Reddit-style).
  parentId  Int?
  /// Paragraph comment: index of the block in the chapter it's attached to (null = chapter discussion).
  paragraph Int?
  body      String
  /// Sum of votes, kept in step with CommentVote in the same transaction.
  score     Int       @default(0)
  /// Soft delete: a deleted comment with replies stays as "[deleted]" so the thread survives.
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chapter Chapter       @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  parent  Comment?      @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[]     @relation("Replies")
  votes   CommentVote[]

  @@index([chapterId, createdAt])
  @@index([chapterId, paragraph])
  @@index([parentId])
}

model CommentVote {
  userId    Int
  commentId Int
  /// +1 or -1
  value     Int

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@id([userId, commentId])
}
